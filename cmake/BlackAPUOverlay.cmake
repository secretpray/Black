function(black_apu_extract_function variable header output)
    string(FIND "${${variable}}" "${header}" start)
    if(start EQUAL -1)
        message(FATAL_ERROR "Pinned APU function changed: ${header}")
    endif()
    string(SUBSTRING "${${variable}}" ${start} -1 function_tail)
    string(FIND "${function_tail}" "\n}\n" end)
    if(end EQUAL -1)
        message(FATAL_ERROR "Pinned APU function end changed: ${header}")
    endif()
    math(EXPR length "${end} + 3")
    string(SUBSTRING "${function_tail}" 0 ${length} extracted)
    set(${output} "${extracted}" PARENT_SCOPE)
endfunction()
black_apu_extract_function(content "static void update_irq(MCPXAPUState *d)\n{" irq_baseline)
