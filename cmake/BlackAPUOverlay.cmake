# Latch the event in fe_method instead (BlackVoiceOverlay.cmake).
set(irq_relatch "    if (d->regs[NV_PAPU_FECTL] & NV_PAPU_FECTL_FEMETHMODE_TRAPPED) {\n        qatomic_or(&d->regs[NV_PAPU_ISTS], NV_PAPU_ISTS_FETINTSTS);\n    }\n")
