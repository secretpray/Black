# Main-register acknowledgements and control writes must also serialize
# with VP queue construction/processing. Internal control helper is retained
# unchanged; all callers enter through the recursive device mutex.
black_apu_extract_function(content "void mcpx_apu_write(void *opaque," control_write)
string(REPLACE "void mcpx_apu_write(" "static void black_apu_control_write(" control_write_locked "${control_write}")
string(APPEND control_write_locked "\nvoid mcpx_apu_write(void *opaque, hwaddr addr, uint64_t val, unsigned int size)\n{\n    MCPXAPUState *d = (MCPXAPUState *)opaque;\n    qemu_mutex_lock(&d->lock);\n    black_apu_control_write(opaque, addr, val, size);\n    qemu_mutex_unlock(&d->lock);\n}\n")
string(REPLACE "${control_write}" "${control_write_locked}" content "${content}")
file(WRITE "${CMAKE_BINARY_DIR}/runtime-overlay/apu_control_fixed.inc" "${control_write_locked}")
file(WRITE "${CMAKE_BINARY_DIR}/runtime-overlay/apu_control_baseline.inc" "${control_write}")
