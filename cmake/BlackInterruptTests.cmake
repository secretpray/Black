string(FIND "${irq_hal}" "/* ============================================================================\n * KeTickCount" irq_hal_end)
if(irq_hal_end EQUAL -1)
    message(FATAL_ERROR "Pinned interrupt HAL prefix changed")
endif()
string(SUBSTRING "${irq_hal}" 0 ${irq_hal_end} irq_test_hal)
file(WRITE "${CMAKE_BINARY_DIR}/runtime-overlay/interrupt_hal_test.inc" "${irq_test_hal}")
set(irq_test_bodies "")
foreach(header IN ITEMS "static void black_OriginalInitializeInterrupt(void)\n{"
                        "static void black_OriginalSynchronizeExecution(void)\n{"
                        "static int black_OriginalRaiseInterrupt(uint32_t vector)\n{")
    black_apu_extract_function(irq_bridge "${header}" body)
    string(APPEND irq_test_bodies "${body}\n")
endforeach()
file(WRITE "${CMAKE_BINARY_DIR}/runtime-overlay/interrupt_bridge_test.inc" "${irq_test_bodies}")
file(READ "${CMAKE_SOURCE_DIR}/ports/macos/overrides/interrupt_gate.inc" irq_test_gate)
file(READ "${CMAKE_SOURCE_DIR}/ports/macos/overrides/audio_completion.inc" irq_test_completion)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
    "${CMAKE_SOURCE_DIR}/ports/macos/overrides/interrupt_gate.inc"
    "${CMAKE_SOURCE_DIR}/ports/macos/overrides/audio_completion.inc")
foreach(variant IN ITEMS fixed baseline no_gate no_irql no_dispatch_guard no_coalescing)
    set(gate "${irq_test_gate}")
    set(completion "${irq_test_completion}")
    if(variant STREQUAL "no_gate")
        string(REPLACE "    return previous;" "    pthread_mutex_unlock(&black_interrupt_gate);\n    return previous;" gate "${gate}")
        string(REPLACE "    pthread_mutex_unlock(&black_interrupt_gate);\n}\n\nvoid black_InterruptRemember" "}\n\nvoid black_InterruptRemember" gate "${gate}")
        set(cases sync_blocks_isr isr_blocks_sync)
    elseif(variant STREQUAL "no_irql")
        string(REPLACE "    if (level > g_current_irql) g_current_irql = level;" "    (void)level;" gate "${gate}")
        set(cases irql)
    elseif(variant STREQUAL "no_dispatch_guard")
        string(REPLACE "    if (!black_IrqlTryEnterDispatch()) {\n        g_eax = MEM32(g_esp + 4);\n        g_esp += 8;\n        return;\n    }\n" "" completion "${completion}")
        string(REPLACE "    black_IrqlLeaveDispatch();\n" "" completion "${completion}")
        set(cases foreign)
    elseif(variant STREQUAL "no_coalescing")
        string(REPLACE "if (MEM32(node) == node && MEM32(node + 4) == node)" "if (1)" completion "${completion}")
        set(cases reuse)
    elseif(variant STREQUAL "baseline")
        set(cases sync_blocks_isr isr_blocks_sync irql)
    else()
        set(cases sync_blocks_isr isr_blocks_sync irql foreign reuse)
    endif()
    set(gate_file "${CMAKE_BINARY_DIR}/runtime-overlay/interrupt_gate_${variant}.inc")
    set(completion_file "${CMAKE_BINARY_DIR}/runtime-overlay/interrupt_completion_${variant}.inc")
    file(WRITE "${gate_file}" "${gate}")
    file(WRITE "${completion_file}" "${completion}")
    add_executable(black-interrupt-${variant} tools/macos/interrupt_sync_test.c)
    target_include_directories(black-interrupt-${variant} PRIVATE
        "${BLACK_MAC_RUNTIME}/src/kernel" "${CMAKE_SOURCE_DIR}/ports/macos/overrides")
    target_link_libraries(black-interrupt-${variant} PRIVATE platform Threads::Threads)
    target_compile_options(black-interrupt-${variant} PRIVATE -fsanitize=address -fno-omit-frame-pointer)
    target_link_options(black-interrupt-${variant} PRIVATE -fsanitize=address)
    target_compile_definitions(black-interrupt-${variant} PRIVATE
        BLACK_INTERRUPT_IRQL_SOURCE="${CMAKE_BINARY_DIR}/runtime-overlay/interrupt_hal_test.inc"
        BLACK_INTERRUPT_GATE_SOURCE="${gate_file}"
        BLACK_INTERRUPT_BRIDGE_BODIES="${CMAKE_BINARY_DIR}/runtime-overlay/interrupt_bridge_test.inc"
        BLACK_INTERRUPT_COMPLETION_SOURCE="${completion_file}")
    if(variant STREQUAL "baseline")
        target_compile_definitions(black-interrupt-${variant} PRIVATE BLACK_INTERRUPT_BASELINE=1)
    endif()
    foreach(case IN LISTS cases)
        add_test(NAME macos_interrupt_${case}_${variant} COMMAND black-interrupt-${variant} ${case})
        set_tests_properties(macos_interrupt_${case}_${variant} PROPERTIES TIMEOUT 10
            ENVIRONMENT "ASAN_OPTIONS=halt_on_error=1:abort_on_error=0:exitcode=1:detect_leaks=0")
        if(NOT variant STREQUAL "fixed")
            set_tests_properties(macos_interrupt_${case}_${variant} PROPERTIES WILL_FAIL TRUE)
        endif()
    endforeach()
endforeach()
