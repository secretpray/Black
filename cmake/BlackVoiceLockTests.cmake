file(READ "${BLACK_APU_VOICE_OVERLAY}" lock_fixed_source)
file(READ "${CMAKE_SOURCE_DIR}/ports/macos/overrides/apu_publish_irq.inc" lock_publish)
foreach(variant IN ITEMS fixed baseline no_publish no_payload no_pio_lock no_control_lock no_se_cancel)
    set(lock_source "${lock_fixed_source}")
    set(lock_publisher "${lock_publish}")
    set(lock_control "${CMAKE_BINARY_DIR}/runtime-overlay/apu_control_fixed.inc")
    set(lock_se "${CMAKE_BINARY_DIR}/runtime-overlay/se_frame_fixed.inc")
    if(variant STREQUAL "baseline")
        file(READ "${BLACK_APU_LOCK_BASELINE}" lock_source)
        set(lock_cases wait edit irq pause shutdown)
    elseif(variant STREQUAL "no_publish")
        set(lock_publisher "void black_apu_publish_pending_irq(MCPXAPUState *d) { (void)d; }\n")
        set(lock_cases irq)
    elseif(variant STREQUAL "no_payload")
        string(REPLACE "    if ((qatomic_read(&d->regs[NV_PAPU_FECTL]) & NV_PAPU_FECTL_FEMETHMODE) !=\n        NV_PAPU_FECTL_FEMETHMODE_TRAPPED) {" "    if (1) {" lock_source "${lock_source}")
        set(lock_cases irq)
    elseif(variant STREQUAL "no_pio_lock")
        string(REPLACE "    qemu_mutex_lock(&d->lock);\n    fe_method(d, (uint32_t)addr, (uint32_t)val);\n    qemu_mutex_unlock(&d->lock);"
            "    fe_method(d, (uint32_t)addr, (uint32_t)val);" lock_source "${lock_source}")
        set(lock_cases pio)
    elseif(variant STREQUAL "no_control_lock")
        set(lock_control "${CMAKE_BINARY_DIR}/runtime-overlay/apu_control_baseline.inc")
        set(lock_cases control)
    elseif(variant STREQUAL "no_se_cancel")
        set(lock_se "${CMAKE_BINARY_DIR}/runtime-overlay/se_frame_baseline.inc")
        set(lock_cases pause shutdown)
    else()
        set(lock_cases wait edit irq pause shutdown pio control)
    endif()
    set(lock_test_vp "${CMAKE_BINARY_DIR}/runtime-overlay/apu_lock_${variant}.c")
    file(WRITE "${lock_test_vp}" "${lock_source}")
    set(lock_test_publish "${CMAKE_BINARY_DIR}/runtime-overlay/apu_publish_${variant}.inc")
    file(WRITE "${lock_test_publish}" "${lock_publisher}")
    add_executable(black-voice-lock-${variant} tools/macos/voice_lock_test.c)
    target_include_directories(black-voice-lock-${variant} PRIVATE
        "${BLACK_MAC_RUNTIME}/src/apu" "${CMAKE_SOURCE_DIR}/ports/macos/overrides")
    target_link_libraries(black-voice-lock-${variant} PRIVATE platform Threads::Threads)
    target_compile_options(black-voice-lock-${variant} PRIVATE -fsanitize=address -fno-omit-frame-pointer)
    target_link_options(black-voice-lock-${variant} PRIVATE -fsanitize=address)
    target_compile_definitions(black-voice-lock-${variant} PRIVATE
        BLACK_VP_SOURCE="${lock_test_vp}"
        BLACK_IRQ_SOURCE="${CMAKE_BINARY_DIR}/runtime-overlay/apu_irq_fixed.inc"
        BLACK_APU_PUBLISH_SOURCE="${lock_test_publish}"
        BLACK_CONTROL_SOURCE="${lock_control}" BLACK_SE_SOURCE="${lock_se}")
    foreach(case IN LISTS lock_cases)
        add_test(NAME macos_voice_lock_${case}_${variant} COMMAND black-voice-lock-${variant} ${case})
        set_tests_properties(macos_voice_lock_${case}_${variant} PROPERTIES TIMEOUT 5
            ENVIRONMENT "ASAN_OPTIONS=halt_on_error=1:abort_on_error=0:exitcode=1:detect_leaks=0")
        if(NOT variant STREQUAL "fixed")
            set_tests_properties(macos_voice_lock_${case}_${variant} PROPERTIES WILL_FAIL TRUE)
        endif()
    endforeach()
endforeach()
