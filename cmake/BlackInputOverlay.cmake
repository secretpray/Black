# Keep the pinned SDL button/packet implementation; replace discovery locally.
set(input_backend "${BLACK_MAC_RUNTIME}/src/input/xinput_device.c")
set(input_hotplug "${CMAKE_SOURCE_DIR}/ports/macos/overrides/input_hotplug.inc")
file(READ "${input_backend}" input_backend_source)
file(READ "${input_hotplug}" input_hotplug_source)
foreach(name IN ITEMS open_controllers input_poll_host input_rescan)
    black_apu_extract_function(input_backend_source "static void ${name}(void)\n{" old_function)
    black_apu_extract_function(input_hotplug_source "static void ${name}(void)\n{" new_function)
    string(REPLACE "${old_function}" "${new_function}" input_backend_source "${input_backend_source}")
endforeach()
set(input_overlay "${CMAKE_BINARY_DIR}/runtime-overlay/xinput_backend.c")
file(WRITE "${input_overlay}" "${input_backend_source}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input_backend}" "${input_hotplug}")
target_compile_definitions(xbox_input PRIVATE BLACK_INPUT_BACKEND_SOURCE="${input_overlay}")
target_include_directories(xbox_input PRIVATE "${BLACK_MAC_RUNTIME}/src/input")
