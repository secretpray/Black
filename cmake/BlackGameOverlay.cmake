# Rename definitions only; original calls/dispatch reach native C wrappers.
set(BLACK_RENAMED
    "sub_000BE3F0|black_OriginalTimerStep" "sub_00209DC0|black_OriginalFilmTick"
    "sub_0021C7EF|black_OriginalAudioCompletion"
    # widescreen 2D (ports/macos/overrides/game_hud.c)
    "sub_000D99A0|black_Original2DBegin" "sub_000D3740|black_Original2DEnd"
    "sub_000D6C00|black_OriginalQuads" "sub_000D6AA0|black_OriginalSolidQuads"
    "sub_000D6850|black_OriginalStrip" "sub_001217C0|black_OriginalFilmDraw"
    "sub_000DA4B0|black_OriginalListDraw")
foreach(pair IN LISTS BLACK_RENAMED)
    string(REPLACE "|" ";" symbols "${pair}")
    list(GET symbols 0 old)
    set(BLACK_FOUND_${old} 0)
endforeach()
# The HUD list's item callback (0x2139D, ebx the item): anchor its points first.
set(BLACK_HUD_ITEM_CALL "{ uint32_t _icall_target = MEM32(ebx + 0x44); PUSH32(esp, 0x000213A0u); RECOMP_ICALL_SAFE_AT(_icall_target, _icall_esp, 0x0002139Du); }")
set(BLACK_FOUND_HUD_ITEM 0)
set(BLACK_FOUND_STICK_LOOK 0)
set(BLACK_FOUND_MOUSE_LOOK 0)
set(BLACK_FOUND_FLASH_MENU 0)
set(BLACK_FOUND_FLASH_NAME 0)
foreach(point HOLD_AIM LOOK_ASSIST SHOT_ASSIST MOD_SPAWN MOD_SILENCER)
    set(BLACK_FOUND_${point} 0)
endforeach()
set(BLACK_FOUND_LANGUAGE 0)
set(BLACK_GAME_OVERLAY_SOURCES "")
foreach(source IN LISTS BLACK_GENERATED)
    file(READ "${source}" original)
    set(edited "${original}")
    set(flash_anchor "loc_00124374: ;\n    _fa = (uint32_t)(MEM32(ebp + 0x3884))")
    string(REPLACE "${flash_anchor}" "" without_flash "${edited}")
    string(LENGTH "${edited}" before_length)
    string(LENGTH "${without_flash}" after_length)
    string(LENGTH "${flash_anchor}" anchor_length)
    math(EXPR flash_matches "(${before_length} - ${after_length}) / ${anchor_length}")
    if(flash_matches GREATER 0)
        math(EXPR BLACK_FOUND_FLASH_MENU "${BLACK_FOUND_FLASH_MENU} + ${flash_matches}")
        string(REPLACE "${flash_anchor}" "loc_00124374: ;\n    black_GameMenu(ebp);\n    _fa = (uint32_t)(MEM32(ebp + 0x3884))" edited "${edited}")
        string(REPLACE "#include \"recomp_funcs.h\"" "#include \"recomp_funcs.h\"\nvoid black_GameMenu(uint32_t);" edited "${edited}")
    endif()
    set(name_anchor "    _cf = (int)(_fa < _fb);\n    PUSH32(esp, ebx);\n    if (CMP_NE(_fa, _fb)) goto loc_00124487;")
    string(REPLACE "${name_anchor}" "" without_name "${edited}")
    string(LENGTH "${edited}" before_length)
    string(LENGTH "${without_name}" after_length)
    string(LENGTH "${name_anchor}" anchor_length)
    math(EXPR name_matches "(${before_length} - ${after_length}) / ${anchor_length}")
    if(name_matches GREATER 0)
        math(EXPR BLACK_FOUND_FLASH_NAME "${BLACK_FOUND_FLASH_NAME} + ${name_matches}")
        string(REPLACE "${name_anchor}" "    _cf = (int)(_fa < _fb);\n    black_GameNameEntry(ebp);\n    PUSH32(esp, ebx);\n    if (CMP_NE(_fa, _fb)) goto loc_00124487;" edited "${edited}")
        string(REPLACE "#include \"recomp_funcs.h\"" "#include \"recomp_funcs.h\"\nvoid black_GameNameEntry(uint32_t);" edited "${edited}")
    endif()
    set(mouse_anchor "    xmm3.f[0] = xmm3.f[0] * MEMF(edi + 0x1C); /* mulss */\n    xmm3.f[0] = xmm3.f[0] + MEMF(esi + 0x18); /* addss */\n    xmm0.f[0] = xmm0.f[0] * xmm1.f[0]; /* mulss */")
    string(REPLACE "${mouse_anchor}" "" without_mouse "${edited}")
    string(LENGTH "${edited}" before_length)
    string(LENGTH "${without_mouse}" after_length)
    string(LENGTH "${mouse_anchor}" anchor_length)
    math(EXPR mouse_matches "(${before_length} - ${after_length}) / ${anchor_length}")
    if(mouse_matches GREATER 0)
        math(EXPR BLACK_FOUND_MOUSE_LOOK "${BLACK_FOUND_MOUSE_LOOK} + ${mouse_matches}")
        string(REPLACE "${mouse_anchor}"
            "    xmm3.f[0] = xmm3.f[0] * MEMF(edi + 0x1C); /* mulss */\n    black_MouseLook(esi, edi, xmm2.f[0]);\n    xmm3.f[0] = xmm3.f[0] + MEMF(esi + 0x18); /* addss */\n    xmm0.f[0] = xmm0.f[0] * xmm1.f[0]; /* mulss */" edited "${edited}")
        string(REPLACE "#include \"recomp_funcs.h\"" "#include \"recomp_funcs.h\"\nvoid black_MouseLook(uint32_t, uint32_t, float);" edited "${edited}")
    endif()
    foreach(point HOLD_AIM LOOK_ASSIST SHOT_ASSIST)
        if(point STREQUAL "HOLD_AIM")
            set(aim_anchor "loc_001EC903: ;\n    SET_LO8(eax, MEM8(esp + 0x16));")
            set(aim_insert "loc_001EC903: ;\n    black_HoldAim(ebx, MEM32(esp + 0x18));\n    SET_LO8(eax, MEM8(esp + 0x16));")
        elseif(point STREQUAL "LOOK_ASSIST")
            set(aim_anchor "loc_001ECE64: ;\n    edx = MEM32(esp + 0x18);\n    esi = MEM32(ebx + 0x8C);")
            set(aim_insert "loc_001ECE64: ;\n    if (!black_ControllerAimAssist()) goto loc_001ECF48;\n    edx = MEM32(esp + 0x18);\n    esi = MEM32(ebx + 0x8C);")
        else()
            set(aim_anchor "loc_001DCDAB: ;\n    eax = MEM32(edi + 0xEC);\n    ecx = MEM32(0x2D12B8);")
            set(aim_insert "loc_001DCDAB: ;\n    if (!black_ControllerAimAssist()) goto loc_001DCE3B;\n    eax = MEM32(edi + 0xEC);\n    ecx = MEM32(0x2D12B8);")
        endif()
        string(REPLACE "${aim_anchor}" "" without_aim "${edited}")
        string(LENGTH "${edited}" before_length)
        string(LENGTH "${without_aim}" after_length)
        string(LENGTH "${aim_anchor}" anchor_length)
        math(EXPR matches "(${before_length} - ${after_length}) / ${anchor_length}")
        if(matches GREATER 0)
            math(EXPR BLACK_FOUND_${point} "${BLACK_FOUND_${point}} + ${matches}")
            string(REPLACE "${aim_anchor}" "${aim_insert}" edited "${edited}")
            string(REPLACE "#include \"recomp_funcs.h\"" "#include \"recomp_funcs.h\"\nvoid black_HoldAim(uint32_t, uint32_t);\nint black_ControllerAimAssist(void);" edited "${edited}")
        endif()
    endforeach()
    # Mods page (ports/macos/overrides/game_mods.c): the spawn point after the
    # title derived silver/M16A2 from progress, and the +9 trainer's silencer point.
    foreach(point MOD_SPAWN MOD_SILENCER)
        if(point STREQUAL "MOD_SPAWN")
            set(mod_anchor "loc_001EE1FF: ;\n    ecx = 0; /* xor self */\n")
            set(mod_insert "loc_001EE1FF: ;\n    black_ModsSpawn(ebp);\n    ecx = 0; /* xor self */\n")
            set(mod_declaration "void black_ModsSpawn(uint32_t);")
        else()
            set(mod_anchor "loc_001E61BF: ;\n    ecx = (uint32_t)(int32_t)SMEM8(eax);\n    edx = MEM32(edx);")
            set(mod_insert "loc_001E61BF: ;\n    black_ModsSilencer(eax);\n    ecx = (uint32_t)(int32_t)SMEM8(eax);\n    edx = MEM32(edx);")
            set(mod_declaration "void black_ModsSilencer(uint32_t);")
        endif()
        string(REPLACE "${mod_anchor}" "" without_mod "${edited}")
        string(LENGTH "${edited}" before_length)
        string(LENGTH "${without_mod}" after_length)
        string(LENGTH "${mod_anchor}" anchor_length)
        math(EXPR matches "(${before_length} - ${after_length}) / ${anchor_length}")
        if(matches GREATER 0)
            math(EXPR BLACK_FOUND_${point} "${BLACK_FOUND_${point}} + ${matches}")
            string(REPLACE "${mod_anchor}" "${mod_insert}" edited "${edited}")
            string(REPLACE "#include \"recomp_funcs.h\"" "#include \"recomp_funcs.h\"\n${mod_declaration}" edited "${edited}")
        endif()
    endforeach()
    # Game language (ports/macos/overrides/game_language.c): the USA start-up
    # 0x1F8100 stores the language word 1 (US) on both of its paths.
    string(FIND "${edited}" "void sub_001F8100(void)\n{" language_function)
    if(NOT language_function EQUAL -1)
        set(language_anchor "    MEM32(0x2D0D78) = 1;\n")
        string(REPLACE "${language_anchor}" "" without_language "${edited}")
        string(LENGTH "${edited}" before_length)
        string(LENGTH "${without_language}" after_length)
        string(LENGTH "${language_anchor}" anchor_length)
        math(EXPR BLACK_FOUND_LANGUAGE "(${before_length} - ${after_length}) / ${anchor_length}")
        string(REPLACE "${language_anchor}" "    MEM32(0x2D0D78) = black_GameLanguageIndex();\n" edited "${edited}")
        string(REPLACE "#include \"recomp_funcs.h\"" "#include \"recomp_funcs.h\"\nuint32_t black_GameLanguageIndex(void);" edited "${edited}")
    endif()
    # TGP's StickLook point, before zoom/frame time, adapted to native C.
    # Verify surrounding stores as well as the operation being intercepted.
    set(stick_anchor "    MEMF(esi + 0xA0) = xmm1.f[0]; /* movss */\n    xmm3.f[0] = xmm3.f[0] * xmm2.f[0]; /* mulss */\n    xmm3.f[0] = xmm3.f[0] * MEMF(edi + 0x1C); /* mulss */")
    string(FIND "${edited}" "${stick_anchor}" stick_position)
    if(NOT stick_position EQUAL -1)
        string(REPLACE "${stick_anchor}" "" without_stick "${edited}")
        string(LENGTH "${edited}" before_length)
        string(LENGTH "${without_stick}" after_length)
        string(LENGTH "${stick_anchor}" anchor_length)
        math(EXPR BLACK_FOUND_STICK_LOOK "${BLACK_FOUND_STICK_LOOK} + (${before_length} - ${after_length}) / ${anchor_length}")
        string(REPLACE "${stick_anchor}"
            "    MEMF(esi + 0xA0) = xmm1.f[0]; /* movss */\n    black_StickLook(MEM8(esi + 0x45), xmm2.f[0], &xmm3.f[0], &xmm0.f[0]);\n    xmm3.f[0] = xmm3.f[0] * xmm2.f[0]; /* mulss */\n    xmm3.f[0] = xmm3.f[0] * MEMF(edi + 0x1C); /* mulss */" edited "${edited}")
        string(REPLACE "#include \"recomp_funcs.h\"" "#include \"recomp_funcs.h\"\nvoid black_StickLook(int, float, float *, float *);" edited "${edited}")
    endif()
    # DSOUND REP MOVS reads GP memory; retain scalar device semantics instead
    # of the generated libc SIMD fast path (faulted at FE830BF8).
    if(source MATCHES "recomp_0012.c$")
        string(FIND "${edited}" "void sub_0021C335(void)\n{" dsound_position)
        if(dsound_position EQUAL -1)
            message(FATAL_ERROR "DSOUND generated chunk layout changed")
        endif()
        string(FIND "${edited}" "#include \"recomp_funcs.h\"" include_position)
        if(include_position EQUAL -1)
            message(FATAL_ERROR "DSOUND generated include anchor changed")
        endif()
        string(REPLACE "#include \"recomp_funcs.h\""
            "#include \"recomp_funcs.h\"\n#include \"${CMAKE_SOURCE_DIR}/ports/macos/overrides/mmio_copy.h\"\n#include \"${CMAKE_SOURCE_DIR}/ports/macos/overrides/audio_completion.h\"" edited "${edited}")
        set(enqueue_start "loc_0021EE37: ;\n")
        set(enqueue_end "    eax = MEM32(esi + 8);\n    MEM32(eax + 0x4B8)")
        string(FIND "${edited}" "${enqueue_start}" begin)
        string(FIND "${edited}" "${enqueue_end}" end)
        if(begin EQUAL -1 OR end EQUAL -1 OR end LESS begin)
            message(FATAL_ERROR "DSOUND completion enqueue boundaries changed")
        endif()
        string(LENGTH "${enqueue_start}" start_size)
        math(EXPR begin "${begin} + ${start_size}")
        math(EXPR length "${end} - ${begin}")
        string(SUBSTRING "${edited}" ${begin} ${length} insertion)
        # Verify the operation sequence, ignoring lifter-only flag bookkeeping.
        string(REGEX REPLACE " /\\*[^\n]*\\*/" "" operations "${insertion}")
        string(REGEX REPLACE "    _f[^\n]*\n" "" operations "${operations}")
        set(expected "    ecx = MEM32(esi + 8);\n    eax = esi + 0x54;\n    ecx = ecx + 0x4A0;\n    MEM32(eax) = ecx;\n    ecx = MEM32(ecx + 4);\n    MEM32(eax + 4) = ecx;\n    MEM32(ecx) = eax;\n    ecx = MEM32(eax);\n    MEM32(ecx + 4) = eax;\n")
        if(NOT operations STREQUAL expected)
            message(FATAL_ERROR "DSOUND completion link contract changed: ${operations}")
        endif()
        string(SUBSTRING "${edited}" 0 ${begin} prefix)
        string(SUBSTRING "${edited}" ${end} -1 suffix)
        set(edited "${prefix}    ecx = black_audio_queue_completion(esi);\n${suffix}")
    endif()
    string(FIND "${edited}" "${BLACK_HUD_ITEM_CALL}" hud_item)
    if(NOT hud_item EQUAL -1)
        math(EXPR BLACK_FOUND_HUD_ITEM "${BLACK_FOUND_HUD_ITEM} + 1")
        string(REPLACE "${BLACK_HUD_ITEM_CALL}" "black_HudItem(); ${BLACK_HUD_ITEM_CALL}" edited "${edited}")
        string(REPLACE "#include \"recomp_funcs.h\"" "#include \"recomp_funcs.h\"\nvoid black_HudItem(void);" edited "${edited}")
    endif()
    foreach(pair IN LISTS BLACK_RENAMED)
        string(REPLACE "|" ";" symbols "${pair}")
        list(GET symbols 0 old)
        list(GET symbols 1 new)
        set(anchor "void ${old}(void)\n{")
        string(FIND "${edited}" "${anchor}" position)
        if(NOT position EQUAL -1)
            math(EXPR BLACK_FOUND_${old} "${BLACK_FOUND_${old}} + 1")
            string(REPLACE "${anchor}" "void ${new}(void)\n{" edited "${edited}")
        endif()
    endforeach()
    if(NOT original STREQUAL edited)
        get_filename_component(name "${source}" NAME)
        set(dest "${CMAKE_BINARY_DIR}/game-overlay/${name}")
        file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/game-overlay")
        set(previous "")
        if(EXISTS "${dest}")
            file(READ "${dest}" previous)
        endif()
        if(NOT previous STREQUAL edited)
            file(WRITE "${dest}" "${edited}")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source}")
        list(APPEND BLACK_GAME_OVERLAY_SOURCES "${dest}")
    else()
        list(APPEND BLACK_GAME_OVERLAY_SOURCES "${source}")
    endif()
endforeach()
if(NOT BLACK_FOUND_MOUSE_LOOK EQUAL 1)
    message(FATAL_ERROR "Expected exactly one verified MouseLook point at 0x1BD6A8")
endif()
foreach(point HOLD_AIM LOOK_ASSIST SHOT_ASSIST)
    if(NOT BLACK_FOUND_${point} EQUAL 1)
        message(FATAL_ERROR "Expected exactly one verified TGP ${point} hook")
    endif()
endforeach()
if(NOT BLACK_FOUND_LANGUAGE EQUAL 2)
    message(FATAL_ERROR "Expected the USA start-up 0x1F8100 to store the language word twice")
endif()
foreach(point MOD_SPAWN MOD_SILENCER)
    if(NOT BLACK_FOUND_${point} EQUAL 1)
        message(FATAL_ERROR "Expected exactly one verified USA ${point} hook (0x1EE1FF / 0x1E61BF)")
    endif()
endforeach()
if(NOT BLACK_FOUND_STICK_LOOK EQUAL 1)
    message(FATAL_ERROR "Expected exactly one verified StickLook point at 0x1BD69F")
endif()
foreach(pair IN LISTS BLACK_RENAMED)
    string(REPLACE "|" ";" symbols "${pair}")
    list(GET symbols 0 symbol)
    if(NOT BLACK_FOUND_${symbol} EQUAL 1)
        message(FATAL_ERROR "Expected exactly one verified USA definition: ${symbol}")
    endif()
endforeach()
if(NOT BLACK_FOUND_HUD_ITEM EQUAL 1)
    message(FATAL_ERROR "Expected exactly one verified HUD item callback at 0x2139D")
endif()

if(NOT BLACK_FOUND_FLASH_MENU EQUAL 1)
    message(FATAL_ERROR "Expected exactly one verified Flash menu hook at 0x124374")
endif()

if(NOT BLACK_FOUND_FLASH_NAME EQUAL 1)
    message(FATAL_ERROR "Expected exactly one verified NameEntry hook at 0x12437B")
endif()
