{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_FLAGS": "-march=x86-64-v2",
                "CMAKE_CXX_FLAGS": "-march=x86-64-v2"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_FLAGS_DEBUG": "-O3",
                "CMAKE_CXX_FLAGS_DEBUG": "-O3",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "relwithdebinfo",
            "displayName": "RelWithDebInfo",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "macos-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "15.0",
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_OBJC_COMPILER": "/usr/bin/clang"
            }
        },
        {
            "name": "macos-arm64",
            "displayName": "BLACK native Apple Silicon (OpenGL)",
            "inherits": "macos-base"
        },
        {
            "name": "macos-runtime",
            "displayName": "macOS runtime checks (no game required)",
            "inherits": "macos-base",
            "cacheVariables": {
                "BLACK_BUILD_GAME": "OFF"
            }
        },
        {
            "name": "macos-metal",
            "displayName": "BLACK native Apple Silicon (ANGLE / Metal)",
            "inherits": "macos-base",
            "cacheVariables": {
                "XEMU_ANGLE_LIB_DIR": "$env{BLACK_ANGLE_LIB_DIR}"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "relwithdebinfo",
            "configurePreset": "relwithdebinfo"
        },
        {
            "name": "macos-arm64",
            "configurePreset": "macos-arm64"
        },
        {
            "name": "macos-runtime",
            "configurePreset": "macos-runtime"
        },
        {
            "name": "macos-metal",
            "configurePreset": "macos-metal"
        }
    ],
    "testPresets": [
        {
            "name": "macos-runtime",
            "configurePreset": "macos-runtime",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}
